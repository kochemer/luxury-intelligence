# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated javascript wrappers (use tsx to run .ts files directly)
scripts/*.js

# discovery cache files (may contain secrets from scraped websites)
data/weeks/*/discovery/fetch/*.html

# FFmpeg binaries (platform-specific, users should download separately)
tools/ffmpeg/ffmpeg
tools/ffmpeg/ffmpeg.exe
tools/ffmpeg/ffprobe
tools/ffmpeg/ffprobe.exe

# Email sending data (contains recipient lists and sent logs)
data/email/recipients.json
data/email/sent/
# Selection measurement harness (local analysis artifacts)
data/harness/

# Local mock digest previews
mock/

# Pipeline artifacts under data/weeks/ — generated by the weekly pipeline and
# never read at request time. Committing them put ~335 MB into every Vercel
# deployment (deployment storage blew past the 10 GB limit in Sept 2026).
# The app only reads podcast.json and email-digest.json from these folders.
# These caches are week-scoped, so a fresh CI checkout loses nothing: each
# weekly run builds its own week's cache from scratch.
data/weeks/*/discovery/
data/weeks/*/podcast/
data/weeks/*/podcast-temp/
data/weeks/*/video/
data/weeks/*/*-voice-only.mp3
